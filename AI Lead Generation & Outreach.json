    {
      "parameters": {
        "jsCode": "const originalLeads = $('Filter Valid Leads').all();\nconst currentInput = $input.all();\n\nreturn currentInput.map((item, index) => {\n  const matchingLead = originalLeads[index]?.json || {};\n\n  // Yeh line check karegi ki lead object ke andar kon-kon si keys available hain\n  // aur unme se jo bhi key 'compan' se match karegi, uska data nikal legi\n  const companyKey = Object.keys(matchingLead).find(key => \n    key.toLowerCase().includes('compan')\n  );\n  \n  const companyName = companyKey ? matchingLead[companyKey] : '';\n\n  return {\n    json: {\n      name: matchingLead.name || matchingLead.Name || '',\n      company: companyName,\n      email: matchingLead.email || matchingLead.Email || '',\n      generated_message: item.json.text || '',\n      status: 'Pending',\n      sent_at: ''\n    }\n  };\n});"
      },
